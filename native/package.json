    "scan": "node driver/bin/scan.ts",
    "hello": "node driver/bin/hello.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@abandonware/noble": "^1.9.2-25"
  },
  "peerDependenciesMeta": {
    "@abandonware/noble": {
      "optional": true
    }
  },
  "dependencies": {
    "lc3codec": "^1.1.8"
  }
}
