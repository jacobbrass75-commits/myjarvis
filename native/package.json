{
  "name": "g2-native",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Prototype driver that talks to Even Realities G2 glasses (and the R1 ring) over BLE without the Even App.",
  "scripts": {
    "test": "node --test 'driver/test/*.test.ts'",
